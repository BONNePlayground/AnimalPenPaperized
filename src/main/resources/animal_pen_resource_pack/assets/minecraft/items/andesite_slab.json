{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "animal_pen:aviary",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 1,
          "cases": [
            {
              "when": "animal_pen:aviary_iron",
              "model": {
                "type": "minecraft:model",
                "model": "animal_pen:block/aviary_iron"
              }
            },
            {
              "when": "animal_pen:aviary_gold",
              "model": {
                "type": "minecraft:model",
                "model": "animal_pen:block/aviary_gold"
              }
            },
            {
              "when": "animal_pen:aviary_copper",
              "model": {
                "type": "minecraft:model",
                "model": "animal_pen:block/aviary_copper"
              }
            },
            {
              "when": "animal_pen:aviary_exposed_copper",
              "model": {
                "type": "minecraft:model",
                "model": "animal_pen:block/aviary_exposed_copper"
              }
            },
            {
              "when": "animal_pen:aviary_weathered_copper",
              "model": {
                "type": "minecraft:model",
                "model": "animal_pen:block/aviary_weathered_copper"
              }
            },
            {
              "when": "animal_pen:aviary_oxidized_copper",
              "model": {
                "type": "minecraft:model",
                "model": "animal_pen:block/aviary_oxidized_copper"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "animal_pen:block/aviary_iron"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:block/andesite_slab"
    }
  }
}